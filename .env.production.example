# FinanceMobile production: copy outside Git as Backend/.env
PORT=3000
ALLOWED_ORIGINS=https://financemobile.example.com
REGISTRATION_ENABLED=false
JWT_SECRET=replace-with-32-or-more-random-characters
JWT_EXPIRES_IN=90d
ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=replace
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=replace
GOOGLE_REDIRECT_URI=https://financemobile.example.com/auth/drive/callback
FINANCE_DB_NAME=financevier
FINANCE_DB_USER=financevier_app
FINANCE_DB_PASSWORD=replace
